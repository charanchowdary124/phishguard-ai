# ==========================================
# PhishGuard AI - Local Compose Environment Variables
# Copy this file to .env only when .env does not already exist.
# Set a unique local password; Compose rejects an empty DB_PASSWORD.
# Never commit real secrets or production passwords to version control.
# For a TLS-terminated production deployment, set SESSION_COOKIE_SECURE=true.
# ==========================================

# Application Port
SERVER_PORT=8080

# Spring Profiles: default (H2 in-memory), prod (PostgreSQL)
SPRING_PROFILES_ACTIVE=default

# Security & Session
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Database Configuration (PostgreSQL for production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=phishguard_db
DB_USER=phishguard_user
DB_PASSWORD=

# ML Model Storage Path
ML_MODEL_DIR=./data/models
DATASET_DIR=./data/datasets
